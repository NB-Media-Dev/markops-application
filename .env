# MySQL Database Connection String for Prisma / Node.js Backend
# Replace 'root' and 'password' with your local MySQL credentials
DATABASE_URL="mysql://root:tiger@localhost:3306/markops"

# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Authentication Secrets
JWT_ACCESS_SECRET="markops_super_secret_access_key_2026"
JWT_REFRESH_SECRET="markops_super_secret_refresh_key_2026"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Application URL & Allowed Hosts
FRONTEND_URL="http://localhost:4200"
NG_ALLOWED_HOSTS="*"
